# QuickBite local environment (copy to .env and adjust; .env is gitignored)
# All values below are development placeholders — never use them in production.

# --- Core -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (host port 55432 avoids clashing with a local Postgres 16) --
POSTGRES_USER=quickbite
POSTGRES_PASSWORD=quickbite_dev_password
POSTGRES_DB=quickbite
# Used by local (non-container) tooling such as pytest and the load test:
DATABASE_URL=postgresql+asyncpg://quickbite:quickbite_dev_password@127.0.0.1:55432/quickbite

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/

# --- Authentication (development secret — replace for production) ---------
JWT_SECRET=quickbite-development-only-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- HTTP / CORS ----------------------------------------------------------
# Flutter Web dev server (5000) and Nginx static host (8080)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000,http://127.0.0.1:5000,http://localhost:4173

# --- Host ports -----------------------------------------------------------
API_PORT=8000
# Optional physical-Android LAN bind is supplied per PowerShell session as
# API_LAN_IP and compose.android-phone.yaml; do not commit a machine IP here.
WEB_PORT=8080
POSTGRES_PORT=55432
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=5672

# --- Simulation delays (workers only; never affects API acceptance) -------
SIM_PAYMENT_DELAY_MS=250
SIM_RESTAURANT_DELAY_MS=200
SIM_DELIVERY_DELAY_MS=200
SIM_NOTIFICATION_DELAY_MS=50

# --- Deterministic demo failure controls (development only) ---------------
# payment: success | fail_twice | always_fail
DEMO_PAYMENT_MODE=success
DEMO_PAYMENT_FAIL_COUNT=2
# restaurant/delivery/notification: success | always_fail
DEMO_RESTAURANT_MODE=success
DEMO_DELIVERY_MODE=success
DEMO_NOTIFICATION_MODE=success
# payment worker crash checkpoints: none | before_commit | after_commit_before_ack
DEMO_CRASH_MODE=none
# Optional: limit the crash to a single order id for reproducible demos
DEMO_CRASH_ORDER_ID=
# outbox dispatcher crash: none | after_publish_before_sent
DISPATCHER_CRASH_MODE=none
DISPATCHER_CRASH_ORDER_ID=

# --- Bounded retries ------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_DELAYS_SECONDS=2,10,30
