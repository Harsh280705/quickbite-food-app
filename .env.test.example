# Isolated local test stack values only. Copy to .env.test; never use in production.
ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_USER=quickbite_test
POSTGRES_PASSWORD=quickbite_test_only
POSTGRES_DB=quickbite_test
POSTGRES_PORT=55433
DATABASE_URL=postgresql+asyncpg://quickbite_test:quickbite_test_only@127.0.0.1:55433/quickbite_test
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
AMQP_URL=amqp://guest:guest@127.0.0.1:5673/
JWT_SECRET=isolated-test-secret-replace-for-any-shared-host
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8001
API_PORT=8001
WEB_PORT=8081
COMPOSE_NETWORK_NAME=quickbite-test-network
POSTGRES_VOLUME_NAME=quickbite-test-postgres-data
RABBITMQ_VOLUME_NAME=quickbite-test-rabbitmq-data
SIM_PAYMENT_DELAY_MS=20
SIM_RESTAURANT_DELAY_MS=20
SIM_DELIVERY_DELAY_MS=20
SIM_NOTIFICATION_DELAY_MS=10
DEMO_PAYMENT_MODE=success
DEMO_PAYMENT_FAIL_COUNT=2
DEMO_RESTAURANT_MODE=success
DEMO_DELIVERY_MODE=success
DEMO_NOTIFICATION_MODE=success
DEMO_CRASH_MODE=none
DEMO_CRASH_ORDER_ID=
DISPATCHER_CRASH_MODE=none
DISPATCHER_CRASH_ORDER_ID=
RETRY_MAX_ATTEMPTS=3
RETRY_DELAYS_SECONDS=0.1,0.2,0.3