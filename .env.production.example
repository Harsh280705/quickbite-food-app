# Production environment for the Cloudflare Tunnel + local Docker Compose backend.
# Copy to .env on the backend host. Never commit .env.
# Generate strong values; do not reuse development placeholders.

ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=quickbite
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
POSTGRES_DB=quickbite
DATABASE_URL=postgresql+asyncpg://quickbite:replace-with-a-strong-unique-password@postgres:5432/quickbite

# RabbitMQ
RABBITMQ_USER=quickbite
RABBITMQ_PASSWORD=replace-with-a-strong-unique-password
AMQP_URL=amqp://quickbite:replace-with-a-strong-unique-password@rabbitmq:5672/

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS: exact production frontend origin only.
CORS_ORIGINS=https://6c264572.quickbite-web.pages.dev

# Simulation defaults for production
SIM_PAYMENT_DELAY_MS=250
SIM_RESTAURANT_DELAY_MS=200
SIM_DELIVERY_DELAY_MS=200
SIM_NOTIFICATION_DELAY_MS=50
DEMO_PAYMENT_MODE=success
DEMO_PAYMENT_FAIL_COUNT=0
DEMO_RESTAURANT_MODE=success
DEMO_DELIVERY_MODE=success
DEMO_NOTIFICATION_MODE=success
DEMO_CRASH_MODE=none
DEMO_CRASH_ORDER_ID=
DISPATCHER_CRASH_MODE=none
DISPATCHER_CRASH_ORDER_ID=
RETRY_MAX_ATTEMPTS=3
RETRY_DELAYS_SECONDS=2,10,30

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token
